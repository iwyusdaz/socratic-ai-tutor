# Model slots use OpenAI-compatible chat completion endpoints
# Copy this file to .env and fill in real values. .env is never committed.
# Use restricted keys with a spending limit. A model never judges its own output.
MODEL_A_BASE_URL=YOUR_BASE_URL_HERE
MODEL_A_API_KEY=YOUR_API_KEY_HERE
MODEL_A_NAME=YOUR_MODEL_NAME_HERE
MODEL_B_BASE_URL=YOUR_BASE_URL_HERE
MODEL_B_API_KEY=YOUR_API_KEY_HERE
MODEL_B_NAME=YOUR_MODEL_NAME_HERE
MODEL_C_BASE_URL=YOUR_BASE_URL_HERE
MODEL_C_API_KEY=YOUR_API_KEY_HERE
MODEL_C_NAME=YOUR_MODEL_NAME_HERE
